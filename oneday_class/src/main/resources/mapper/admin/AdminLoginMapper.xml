<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.oneclass.admin.login.AdminLoginDAO">

	<select id="selectAdminById"
	        parameterType="string"
	        resultType="kr.co.oneclass.admin.login.AdminDTO">
	
	    SELECT
	        MANAGER_CODE,
	        ID,
	        PASSWORD,
	        NAME,
	        EMAIL
	    FROM MANAGER
	    WHERE ID = #{id}
	
	</select>

</mapper>