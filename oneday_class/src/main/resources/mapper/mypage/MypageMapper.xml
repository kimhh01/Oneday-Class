<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.co.oneclass.mypage.MypageDAO">

    <!-- 결과 맵핑 정의 -->
    <resultMap id="mypageNoticeResultMap" type="kr.co.oneclass.notice.NoticeDTO">
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="noticeDate" column="input_date"/>
        <result property="noticeType" column="notice_type"/>
    </resultMap>

    <!-- 최근 공지사항 조회 쿼리 -->
    <select id="selectRecentNotice" resultMap="mypageNoticeResultMap">
        SELECT * FROM (
          SELECT title, content, input_date, notice_type 
          FROM notice 
          ORDER BY input_date DESC
        ) WHERE ROWNUM = 1
    </select>

</mapper>